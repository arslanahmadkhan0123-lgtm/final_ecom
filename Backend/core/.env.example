# Gmail SMTP settings. Use a Gmail App Password, not your normal password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-store-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=your-store-gmail@gmail.com
FRONTEND_URL=http://127.0.0.1:5173
